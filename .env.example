# Bind to the mini-PC's LAN interface, not localhost. Keep this receiver private.
LISTEN_ADDRESS=0.0.0.0
PORT=8765
# Created by `square-drive init`; never commit or share it.
UPLOAD_TOKEN=
# Must NOT be inside a cloud-synced folder.
LOCAL_DATA_DIR=C:\SquareDriveConnectorData
# Set this to your existing Google Drive for desktop My Drive location plus Golf Performance\Square.
DRIVE_OUTPUT_DIR=
TIMEZONE=America/Vancouver
MAX_UPLOAD_MIB=20
